# Keep source/docs consistent across Windows and macOS.
* text=auto

*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.bat text eol=crlf

# Binary scientific/model/media formats.
*.pickle binary
*.npy binary
*.npz binary
*.mat binary
*.edf binary
*.bdf binary
*.h5 binary
*.hdf5 binary
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.avi binary
